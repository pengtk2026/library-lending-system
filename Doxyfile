# ============================================================
# Doxyfile — 简易图书借阅系统 源码文档生成配置
#
# 用法：安装 Doxygen 与 Graphviz（dot）后，在项目根目录执行
#         doxygen Doxyfile
# 输出：build/doxygen/html/index.html（该目录已被 .gitignore 排除，不入库）
#
# 说明：只索引自写源码与 README。tools/ 下 FLTK + SQLite 共 63 万行
#       第三方源码不扫描，否则生成极慢且图谱不可用。
# ============================================================

PROJECT_NAME           = "简易图书借阅系统"
PROJECT_BRIEF          = "C++17 / FLTK 1.4.5 / SQLite 四层架构教学项目"
OUTPUT_DIRECTORY       = build/doxygen
OUTPUT_LANGUAGE        = Chinese
INPUT_ENCODING         = UTF-8
CREATE_SUBDIRS         = NO

INPUT                  = src include README.md
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.cpp *.h *.md
RECURSIVE              = YES
EXCLUDE                = tools build data output docs .git .github
EXCLUDE_PATTERNS       = */tools/* */build/* */data/* */output/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
JAVADOC_AUTOBRIEF      = NO
MARKDOWN_SUPPORT       = YES
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO

HAVE_DOT               = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_NUM_THREADS        = 4

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
